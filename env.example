# Copy this file to `.env` for local development.
# For a Vercel deployment, set these same names under
# Project Settings -> Environment Variables instead (no .env file needed).

# --- Browser app (must be prefixed with VITE_ to be exposed to the client) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Serverless keep-alive cron (api/keep-alive.js) ---
# Same two values, without the VITE_ prefix. Server-side code cannot read
# VITE_ variables, so both pairs are required or the daily cron will fail.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
